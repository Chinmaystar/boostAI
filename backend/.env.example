# Server
PORT=3001

# Vision provider: "ollama" | "gemini" | "deepseek-ocr"
VISION_PROVIDER=ollama

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:2b

# Gemini
GEMINI_API_KEY=your_gemini_api_key

# DeepSeek OCR-2 (community demo)
DEEPSEEK_OCR_URL=https://deepseek-ocr-v2-demo.vercel.app/api/v1
DEEPSEEK_OCR_API_KEY=whale

# Per-page timeout in milliseconds
VISION_TIMEOUT=300000

# Supabase PostgreSQL connection string
DATABASE_URL=postgresql://...

# JWT signing secret
JWT_SECRET=change-this-to-a-random-string

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenRouter LLM (for study content generation)
DEEPSEEK_LLM_URL=https://openrouter.ai/api/v1
DEEPSEEK_LLM_API_KEY=.
DEEPSEEK_LLM_MODEL=deepseek/deepseek-chat

# Supabase Storage (for PDF storage)
SUPABASE_URL=https://xsjvoqyxpxzyltgzrjtr.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=pdfs
